FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.prod.conf /etc/nginx/conf.d/site.http.conf
COPY nginx.prod.ssl.conf /etc/nginx/conf.d/site.https.conf
COPY docker-entrypoint/10-use-ssl-if-ready.sh /docker-entrypoint.d/10-use-ssl-if-ready.sh
RUN chmod +x /docker-entrypoint.d/10-use-ssl-if-ready.sh
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
EXPOSE 443

CMD ["nginx", "-g", "daemon off;"]
